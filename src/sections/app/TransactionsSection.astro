---
import { IconPlus } from "@tabler/icons-react";
import LatestTransactionsList from "../../components/LatestTransactionsList.astro";
---

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-2xl font-bold text-neutral-800">Transacciones</h2>
      <p class="text-sm text-neutral-500">Tus movimientos recientes</p>
    </div>

    <a href="/app/manage-transactions" class="no-underline group">
      <div
        class="flex items-center justify-center h-10 w-10 md:w-auto md:px-4 rounded-full bg-black text-white shadow-lg shadow-neutral-300/50 transition-transform active:scale-95 group-hover:bg-neutral-800"
      >
        <IconPlus size={20} />
        <span class="hidden md:block ml-2 text-sm font-medium">Nueva</span>
      </div>
    </a>
  </div>

  <div class="flex flex-col gap-6">
    <LatestTransactionsList />
  </div>
</div>
