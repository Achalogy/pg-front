---
import LoadingIndicator from "astro-loading-indicator/component";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

const { title, desc } = Astro.props;
---

<html lang="es" about="acha">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title ?? "PG - ACHA"}</title>
    <meta name="description" content={desc ?? ""} />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico?v=16" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="color-scheme" content="light" />

    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <ClientRouter />
  <LoadingIndicator
    color="rgb(248, 133,133)"
    height="0.25rem"
    threshold={100}
  />
  <body>
    <main>
      <div class={`flex flex-col min-h-screen bg-neutral-50`}>
        <script is:inline>
          function changeTheme() {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; theme=`);
            const theme = parts.pop().split(";").shift();
            const nTheme = theme == "dark" ? "light" : "dark";
            document.cookie = `theme=${nTheme}; expires=${new Date(Date.now() + 10e9).toUTCString()}; path=/`;
            window.location.reload();
          }
        </script>

        <div class="min-h-dvh">
          <slot />
        </div>

        <footer
          class="bg-white flex flex-col gap-2 items-center justify-center min-h-[8dvh]"
        >
          <p>Proyecto de Innovación y Emprendimiento de TI</p>
          <p>Pontificia Universidad Javeriana</p>
          <p class="text-neutral-500">© Acha 2025</p>
        </footer>
      </div>
    </main>
  </body>


</html>
