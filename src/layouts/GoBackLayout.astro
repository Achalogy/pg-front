---
import BaseLayout from "./BaseLayout.astro";
---

<BaseLayout>
  <div class="h-full max-w-240 w-full mx-auto">
    <a onclick="history.back()" class="no-underline! fixed top-0 left-0">
      <div
        class="bg-white z-10 backdrop-blur-2xl w-dvw h-12 flex justify-center items-center"
      >
        <b class="text-black text-center">Volver</b>
      </div>
    </a>
    <div class="h-12"></div>
    <slot />
  </div>
</BaseLayout>
