---
import { IconChevronRight } from "@tabler/icons-react";
import AppLayout from "./AppLayout.astro";
---

<AppLayout>
  <div class="flex flex-col gap-2">
    <a
      class="flex gap-2 items-center p-2 px-3 rounded bg-white"
      href="/app/tools/renta"
    >
      <IconChevronRight />
      Calculadora Renta
    </a>
    <a
      class="flex gap-2 items-center p-2 px-3 rounded bg-white"
      href="/app/tools/sim-ahorro"
    >
      <IconChevronRight />
      Simulador Ahorro</a
    >
    <a
      class="flex gap-2 items-center p-2 px-3 rounded bg-white"
      href="/app/tools/sim-compuesto"
    >
      <IconChevronRight />
      Simulador Interes Compuesto</a
    >
  </div>

  <slot />
</AppLayout>
