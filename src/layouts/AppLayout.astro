---
import BalanceComponent from "../components/BalanceComponent.astro";
import ProfileComponent from "../components/ProfileComponent.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  IconCalendar,
  IconCashEdit,
  IconChartAreaLineFilled,
  IconPigMoney,
  IconTools,
  IconTransfer,
} from "@tabler/icons-react";
import headersWAuth from "../utils/headersWAuth";

const route = new URL(Astro.request.url).pathname.split("/app/")?.at(-1);
console.log(route);
---

<BaseLayout>
  <div class="h-full max-w-240 w-full mx-auto">
    <div class="flex flex-col gap-4 lg:gap-8 p-4 lg:p-8 min-h-dvh">
      <ProfileComponent />

      <div class="flex flex-col gap-6 p-2 lg:p-4">
        <h2 class="text-2xl">
          <b>Balance</b>
        </h2>
        <a href="/app/manage-transactions" class="no-underline!">
          <BalanceComponent
            transition:name="balance-component"
            transition:persist
            transition:animate="slide"
          />
        </a>
      </div>

      <div class="flex justify-between">
        <a href="/app/transactions" class="no-underline! text-black! w-1/4">
          <div class="flex flex-col items-center w-full gap-3">
            <div
              class={`flex items-center justify-center rounded-full h-16 w-16 ${(route ?? "").match(/transactions(\/.*)?/) ? "bg-indigo-200 text-white" : "bg-white"}`}
            >
              <IconTransfer className="w-8 h-8" />
            </div>
            <b class="text-xs">Transacciones</b>
          </div></a
        >
        <a href="/app/goals" class="no-underline! text-black! w-1/4">
          <div class="flex flex-col items-center w-full gap-3">
            <div
              class={`flex items-center justify-center rounded-full h-16 w-16 shadow ${(route ?? "").match(/goals(\/.*)?/) ? "bg-indigo-200 text-white" : "bg-white"}`}
            >
              <IconPigMoney className="w-8 h-8" />
            </div>
            <b class="text-xs">Metas</b>
          </div></a
        >
        <a href="/app/planner" class="no-underline! text-black! w-1/4">
          <div class="flex flex-col items-center w-full gap-3">
            <div
              class={`flex items-center justify-center rounded-full h-16 w-16 shadow ${(route ?? "").match(/planner(\/.*)?/) ? "bg-indigo-200 text-white" : "bg-white"}`}
            >
              <IconCalendar className="w-8 h-8" />
            </div>
            <b class="text-xs">Planeación</b>
          </div></a
        >
        <a href="/app/cdts" class="no-underline! text-black! w-1/4">
          <div class="flex flex-col items-center w-full gap-3">
            <div
              class={`flex items-center justify-center rounded-full h-16 w-16 shadow ${(route ?? "").match(/cdts(\/.*)?/) ? "bg-indigo-200 text-white" : "bg-yellow-100"}`}
            >
              <IconChartAreaLineFilled className="w-8 h-8" />
            </div>
            <b class="text-xs">Crecimiento</b>
          </div></a
        >
      </div>

      <slot />
    </div>
  </div>
</BaseLayout>
