---
import BalanceComponent from "../components/BalanceComponent.astro";
import ProfileComponent from "../components/ProfileComponent.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  IconCashEdit,
  IconPigMoney,
  IconTools,
  IconTransfer,
} from "@tabler/icons-react";
import headersWAuth from "../utils/headersWAuth";

try {
  headersWAuth(Astro);
} catch {
  return Astro.redirect("/log-in");
}

const route = new URL(Astro.request.url).pathname.split("/")?.at(-1);
---

<BaseLayout>
  <div class="flex flex-col gap-4 lg:gap-8 p-4 lg:p-8 bg-neutral-50 min-h-dvh">
    <ProfileComponent />

    <div class="flex flex-col gap-6 p-4">
      <h2 class="text-2xl">
        <b>Balance</b>
      </h2>
      <a href="/app/manage-transactions" class="no-underline!">
        <BalanceComponent
          transition:name="balance-component"
          transition:persist
          transition:animate="slide"
        />
      </a>
    </div>

    <div class="flex justify-between">
      <a href="/app/transactions" class="no-underline! text-black! w-1/4">
        <div class="flex flex-col items-center w-full gap-3">
          <div
            class={`flex items-center justify-center rounded-full h-16 w-16 ${route == "transactions" ? "bg-indigo-200 text-white" : "bg-white"}`}
          >
            <IconTransfer className="w-8 h-8" />
          </div>
          <b class="text-xs">Transacciones</b>
        </div></a
      >
      <a href="/app/goals" class="no-underline! text-black! w-1/4">
        <div class="flex flex-col items-center w-full gap-3">
          <div
            class={`flex items-center justify-center rounded-full h-16 w-16 ${route == "goals" ? "bg-indigo-200 text-white" : "bg-white"}`}
          >
            <IconPigMoney className="w-8 h-8" />
          </div>
          <b class="text-xs">Metas</b>
        </div></a
      >
      <a href="/app/tools" class="no-underline! text-black! w-1/4">
        <div class="flex flex-col items-center w-full gap-3">
          <div
            class={`flex items-center justify-center rounded-full h-16 w-16 ${route == "tools" ? "bg-indigo-200 text-white" : "bg-white"}`}
          >
            <IconTools className="w-8 h-8" />
          </div>
          <b class="text-xs">Herramientas</b>
        </div></a
      >
      <a href="/app/education" class="no-underline! text-black! w-1/4">
        <div class="flex flex-col items-center w-full gap-3">
          <div
            class={`flex items-center justify-center rounded-full h-16 w-16 ${route == "education" ? "bg-indigo-200 text-white" : "bg-white"}`}
          >
            <IconCashEdit className="w-8 h-8" />
          </div>
          <b class="text-xs">Educación</b>
        </div></a
      >
    </div>

    <slot />
  </div>
</BaseLayout>
