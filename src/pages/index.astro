---
import AppLayout from "../layouts/AppLayout.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section
    class="bg-indigo-600 text-white min-h-screen flex flex-col justify-center items-center relative overflow-hidden"
  >
    <div class="container mx-auto px-6 text-center space-y-6 z-10 relative">
      <h1 class="text-4xl md:text-6xl font-bold leading-tight">
        Controla tus Finanzas <br /> de manera fácil y divertida
      </h1>
      <p class="text-lg md:text-2xl max-w-2xl mx-auto">
        Automatiza tu ahorro, organiza tus gastos, y aprende a manejar tu dinero
        con guías y simuladores pensados para Colombia.
      </p>
      <a
        href="/app"
        class="no-underline! inline-block mt-6 bg-white text-indigo-600! font-bold px-8 py-4 rounded-lg shadow-lg hover:shadow-xl transition duration-300"
      >
        Comienza Ahora
      </a>
    </div>
    <!-- Decoración con círculos -->
    <div
      class="absolute -top-32 -left-32 w-96 h-96 bg-indigo-400 rounded-full opacity-20 animate-pulse"
    >
    </div>
    <div
      class="absolute -bottom-32 -right-32 w-96 h-96 bg-indigo-400 rounded-full opacity-20 animate-pulse delay-200"
    >
    </div>
  </section>

  <section class="bg-gray-50 py-20">
    <div class="container mx-auto px-6 grid md:grid-cols-3 gap-10 text-center">
      <div
        class="bg-white p-6 rounded-xl shadow-lg hover:shadow-2xl transition duration-300"
      >
        <h3 class="text-xl font-bold mb-3">Control de gastos</h3>
        <p>
          Registra tus ingresos y gastos fácilmente, clasifícalos y visualiza tu
          dinero en tiempo real.
        </p>
      </div>
      <div
        class="bg-white p-6 rounded-xl shadow-lg hover:shadow-2xl transition duration-300"
      >
        <h3 class="text-xl font-bold mb-3">Ahorro y metas</h3>
        <p>
          Define objetivos financieros, calcula cuánto necesitas ahorrar y sigue
          tu progreso con simuladores inteligentes.
        </p>
      </div>
      <div
        class="bg-white p-6 rounded-xl shadow-lg hover:shadow-2xl transition duration-300"
      >
        <h3 class="text-xl font-bold mb-3">Guías y educación</h3>
        <p>
          Aprende sobre impuestos, inversión y presupuesto con guías prácticas y
          ejemplos claros para Colombia.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-indigo-600 text-white py-20">
    <div class="container mx-auto px-6 text-center space-y-6">
      <h2 class="text-3xl md:text-4xl font-bold">
        Empieza hoy y toma control de tu dinero
      </h2>
      <p class="max-w-2xl mx-auto text-lg md:text-xl">
        Todo en un solo lugar: simuladores, metas personalizadas, guías
        educativas y control de gastos.
      </p>
      <a
        href="/app"
        class="no-underline! inline-block mt-6 bg-white text-indigo-600! font-bold px-8 py-4 rounded-lg shadow-lg hover:shadow-xl transition duration-300"
      >
        Comenzar Ahora
      </a>
    </div>
  </section>
</BaseLayout>
