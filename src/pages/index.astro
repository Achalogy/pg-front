---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  IconArrowRight,
  IconTrendingUp,
  IconChefHat,
  IconBuildingBank,
  IconCheck,
  IconStar,
  IconShoppingCart,
} from "@tabler/icons-react";
---

<BaseLayout>
  <section class="relative pt-20 pb-32 overflow-hidden bg-white">
    <div
      class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-indigo-100 via-white to-white opacity-70"
    >
    </div>

    <div class="container mx-auto px-6 relative z-10">
      <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20">
        <div class="flex-1 text-center lg:text-left space-y-8">
          <div
            class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 border border-indigo-100 text-indigo-600 text-xs font-bold uppercase tracking-wide"
          >
            <span class="relative flex h-2 w-2">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"
              ></span>
              <span
                class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"
              ></span>
            </span>
            Disponible en Colombia 🇨🇴
          </div>

          <h1
            class="text-5xl lg:text-7xl font-extrabold text-slate-900 leading-[1.1] tracking-tight"
          >
            Tu dinero y tu mercado, <br />
            <span
              class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-violet-500"
            >
              en el mismo lugar.
            </span>
          </h1>

          <p
            class="text-lg text-slate-600 max-w-xl mx-auto lg:mx-0 leading-relaxed"
          >
            Deja de adivinar en qué se te fue la plata. Planifica tu menú
            semanal, compra en el Éxito con descuento y pon tus ahorros a crecer
            en CDTs reales.
          </p>

          <div
            class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4"
          >
            <a
              href="/app"
              class="group relative inline-flex h-12 items-center justify-center overflow-hidden rounded-full bg-slate-900 px-8 font-medium text-white! transition-all duration-300 hover:bg-slate-800 hover:ring-2 hover:ring-slate-800 hover:ring-offset-2 no-underline!"
            >
              <span class="mr-2">Comenzar Gratis</span>
              <IconArrowRight
                size={18}
                className="group-hover:translate-x-1 transition-transform"
              />
            </a>
          </div>
        </div>

        <div
          class="flex-1 relative w-full max-w-md lg:max-w-full flex justify-center perspective-1000"
        >
          <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[120%] bg-indigo-500/20 rounded-full blur-3xl -z-10"
          >
          </div>

          <div
            class="relative w-[300px] h-[600px] bg-slate-900 rounded-[2.5rem] shadow-2xl border-[8px] border-slate-900 overflow-hidden ring-1 ring-white/20 transform rotate-[-6deg] hover:rotate-0 transition-transform duration-500"
          >
            <div
              class="absolute top-0 left-1/2 -translate-x-1/2 w-1/3 h-6 bg-slate-900 rounded-b-xl z-20"
            >
            </div>

            <div class="w-full h-full bg-slate-50 flex flex-col pt-10 px-4">
              <div class="flex justify-between items-center mb-6">
                <div class="text-sm font-bold text-slate-700">
                  Hola, Miguel 👋
                </div>
                <div
                  class="w-8 h-8 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center font-bold text-xs"
                >
                  M
                </div>
              </div>

              <div
                class="bg-indigo-600 text-white p-4 rounded-2xl mb-4 shadow-lg shadow-indigo-200"
              >
                <div class="text-xs opacity-80 mb-1">Disponible</div>
                <div class="text-2xl font-bold mb-3">$ 1.250.000</div>
                <div class="flex gap-2 text-[10px] font-medium">
                  <span class="bg-white/20 px-2 py-1 rounded">Ingresos</span>
                  <span class="bg-white/20 px-2 py-1 rounded">Gastos</span>
                </div>
              </div>

              <div
                class="bg-white p-3 rounded-xl shadow-sm border border-slate-100 mb-2"
              >
                <div class="flex items-center gap-3">
                  <div
                    class="w-10 h-10 rounded-lg bg-orange-100 flex items-center justify-center text-lg"
                  >
                    🍗
                  </div>
                  <div>
                    <div class="text-xs font-bold text-slate-800">
                      Pollo Sudado
                    </div>
                    <div class="text-[10px] text-slate-400">
                      Ingredientes listos
                    </div>
                  </div>
                  <div class="ml-auto text-xs font-bold text-green-600">
                    -$22k
                  </div>
                </div>
              </div>

              <div
                class="mt-auto mb-6 bg-yellow-400 p-3 rounded-xl text-xs font-bold flex items-center justify-between shadow-sm"
              >
                <span>🛍️ Pagar en Éxito</span>
                <span class="bg-black text-white px-2 py-1 rounded"
                  >Ahorras 15%</span
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-slate-50">
    <div class="container mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">
          No es magia, es planificación.
        </h2>
        <p class="text-slate-600">
          Una suite completa de herramientas financieras diseñadas
          específicamente para el mercado colombiano.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-[300px]">
        <div
          class="md:col-span-2 group relative overflow-hidden rounded-3xl bg-white p-8 shadow-sm border border-slate-200 hover:shadow-md transition-shadow"
        >
          <div class="relative z-10 h-full flex flex-col justify-between">
            <div
              class="w-12 h-12 bg-indigo-100 text-indigo-600 rounded-xl flex items-center justify-center mb-4"
            >
              <IconChefHat size={28} />
            </div>
            <div>
              <h3 class="text-2xl font-bold text-slate-900 mb-2">
                Del menú al carrito
              </h3>
              <p class="text-slate-500 max-w-md">
                Planifica tus comidas de la semana y generamos tu lista de
                mercado automáticamente con precios del Éxito.
              </p>
            </div>
          </div>
          <div
            class="absolute right-[-20px] top-1/2 -translate-y-1/2 opacity-50 group-hover:scale-105 transition-transform duration-500"
          >
            <div class="w-48 h-48 bg-yellow-100 rounded-full blur-2xl"></div>
            <div
              class="absolute top-10 right-10 bg-white p-4 rounded-xl shadow-lg border border-slate-100 rotate-[-10deg]"
            >
              <div class="flex items-center gap-2 text-sm font-bold">
                <IconCheck size={16} class="text-green-500" /> Lentejas
              </div>
              <div class="flex items-center gap-2 text-sm font-bold mt-2">
                <IconCheck size={16} class="text-green-500" /> Arroz Diana
              </div>
            </div>
          </div>
        </div>

        <div
          class="relative overflow-hidden rounded-3xl bg-slate-900 p-8 shadow-sm text-white group"
        >
          <div
            class="w-12 h-12 bg-white/10 text-white rounded-xl flex items-center justify-center mb-6"
          >
            <IconTrendingUp size={28} />
          </div>
          <h3 class="text-xl font-bold mb-2">Rentabilidad real</h3>
          <p class="text-slate-400 text-sm mb-6">
            Accede a tasas de CDTs premium que los bancos no muestran en
            ventanilla.
          </p>

          <div class="absolute bottom-0 left-0 w-full p-6">
            <div
              class="bg-slate-800 rounded-xl p-3 flex justify-between items-center group-hover:-translate-y-2 transition-transform"
            >
              <div class="flex items-center gap-2">
                <div
                  class="w-8 h-8 rounded-full bg-green-500/20 text-green-400 flex items-center justify-center"
                >
                  <IconBuildingBank size={16} />
                </div>
                <div class="text-xs font-bold">Coop. X</div>
              </div>
              <div class="text-green-400 font-bold text-sm">14.5% E.A.</div>
            </div>
          </div>
        </div>

        <div class="rounded-3xl bg-white p-8 shadow-sm border border-slate-200">
          <div
            class="w-12 h-12 bg-green-100 text-green-600 rounded-xl flex items-center justify-center mb-4"
          >
            <IconShoppingCart size={28} />
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">
            Sin gastos hormiga
          </h3>
          <p class="text-slate-500 text-sm">
            Identifica y elimina esos gastos pequeños que se comen tu sueldo a
            fin de mes.
          </p>
        </div>

        <div
          class="md:col-span-2 rounded-3xl bg-indigo-600 p-8 shadow-sm text-white relative overflow-hidden flex items-center"
        >
          <div class="relative z-10 flex-1">
            <h3 class="text-2xl font-bold mb-2">Alianza exclusiva Éxito</h3>
            <p class="text-indigo-100">
              Descuentos automáticos al pedir tu mercado desde la app.
            </p>
          </div>
          <div
            class="text-9xl opacity-20 absolute right-4 bottom-[-20px] rotate-12"
          >
            🛍️
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="container mx-auto px-6">
      <div
        class="bg-slate-900 rounded-[3rem] p-12 text-center relative overflow-hidden"
      >
        <div class="absolute top-0 left-0 w-full h-full">
          <div
            class="absolute top-[-50%] left-[-10%] w-[500px] h-[500px] bg-indigo-600/30 rounded-full blur-[100px]"
          >
          </div>
          <div
            class="absolute bottom-[-50%] right-[-10%] w-[500px] h-[500px] bg-violet-600/30 rounded-full blur-[100px]"
          >
          </div>
        </div>

        <div class="relative z-10 max-w-2xl mx-auto space-y-8">
          <h2 class="text-3xl md:text-5xl font-bold text-white tracking-tight">
            ¿Listo para organizar tu vida?
          </h2>
          <p class="text-slate-400 text-lg">
            Únete hoy y empieza a planear tu primera semana. Es gratis.
          </p>
          <a
            href="/app"
            class="inline-block bg-white text-slate-900! font-bold px-8 py-4 rounded-full hover:scale-105 transition-transform duration-300 shadow-xl no-underline!"
          >
            Crear cuenta gratis
          </a>
          <p class="text-xs text-slate-500 mt-4">
            Sin tarjeta de crédito requerida • Cancelas cuando quieras
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
