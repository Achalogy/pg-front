---
import BalanceComponent from "../components/BalanceComponent.astro";
import LatestTransactionsList from "../components/LatestTransactionsList.astro";
import ProfileComponent from "../components/ProfileComponent.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  IconCashEdit,
  IconPigMoney,
  IconPlus,
  IconTools,
  IconTransfer,
} from "@tabler/icons-react";
import headersWAuth from "../utils/headersWAuth";

try {
  headersWAuth(Astro);
} catch {
  return Astro.redirect('/log-in')
}
---

<BaseLayout>
  <div class="flex flex-col gap-4 lg:gap-8 p-4 lg:p-8 bg-neutral-50 min-h-dvh">
    <ProfileComponent />

    <div class="flex flex-col gap-6 p-4">
      <h2 class="text-2xl">
        <b>Balance</b>
      </h2>
      <a href="/transactions" class="no-underline!"> <BalanceComponent /></a>
    </div>

    <div class="flex justify-between">
      <div class="flex flex-col items-center w-1/4 gap-3">
        <div
          class="flex items-center justify-center rounded-full h-16 w-16 bg-indigo-200 text-white"
        >
          <IconTransfer className="w-8 h-8" />
        </div>
        <b class="text-xs">Transacciones</b>
      </div>
      <div class="flex flex-col items-center w-1/4 gap-3">
        <div
          class="flex items-center justify-center rounded-full h-16 w-16 bg-white"
        >
          <IconPigMoney className="w-8 h-8" />
        </div>
        <b class="text-xs">Metas</b>
      </div>
      <div class="flex flex-col items-center w-1/4 gap-3">
        <div
          class="flex items-center justify-center rounded-full h-16 w-16 bg-white"
        >
          <IconTools className="w-8 h-8" />
        </div>
        <b class="text-xs">Herramientas</b>
      </div>
      <div class="flex flex-col items-center w-1/4 gap-3">
        <div
          class="flex items-center justify-center rounded-full h-16 w-16 bg-white"
        >
          <IconCashEdit className="w-8 h-8" />
        </div>
        <b class="text-xs">Educación</b>
      </div>
    </div>

    <div class="flex flex-col gap-6 p-4">
      <div class="flex items-center justify-between text-[1.5rem]/[0.1rem]">
        <h2>
          <b>Transacciones</b>
        </h2>
        <a href="/transactions" class="no-underline!">
          <div
            class="flex items-center justify-center h-8 rounded-full bg-white text-neutral-500 mt-2 text-xs gap-2 px-2 select-none"
          >
            <IconPlus />
            <p class="mb-1">agregar</p>
          </div></a
        >
      </div>
      <div class="flex flex-col gap-4">
        <LatestTransactionsList />
      </div>
    </div>
  </div>
</BaseLayout>
