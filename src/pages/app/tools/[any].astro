---
import RentaComponent from "../../../components/RentaComponent.astro";
import SimAhorroComponent from "../../../components/SimAhorroComponent.astro";
import SimCompuestoComponent from "../../../components/SimCompuestoComponent.astro";
import ToolLayout from "../../../layouts/ToolLayout.astro";
import headersWAuth from "../../../utils/headersWAuth";
try {
  headersWAuth(Astro);
} catch {
  return Astro.redirect("/log-in");
}

const path = new URL(Astro.request.url).pathname;
---

<ToolLayout>
  {
    path.endsWith("renta") ? <RentaComponent /> :
    path.endsWith("sim-ahorro") ? <SimAhorroComponent /> :
    path.endsWith("sim-compuesto") ? <SimCompuestoComponent />
    : <p></p>
  }
</ToolLayout>
