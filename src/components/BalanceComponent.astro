---
import getBalance from "../api/user/getBalance";
import { IconArrowDown, IconArrowUp } from "@tabler/icons-react";
import pattern from "../../assets/money_doodles.webp";
import customCashFormat from "../utils/customCashFormat";

let balance: null | {
  balanceTotal: number;
  incomeTotal: number;
  expenseTotal: number;
  balanceDisponible: number;
  incomeDisponible: number;
  expenseDisponible: number;
} = null;

try {
  balance = await getBalance(Astro);
} catch (err) {}
---

{
  balance ? (
    <div class="relative flex flex-col gap-4 p-8 lg:p-10 rounded-[2rem] lg:rounded-[3rem] text-white bg-[#333333] overflow-hidden min-h-50">
      <img
        src={pattern.src}
        alt=""
        class="absolute inset-0 w-full h-full object-cover opacity-20"
      />
      <div class="relative z-10 flex flex-col gap-4 justify-between flex-1">
        <p class="text-3xl font-semibold">
          ${customCashFormat(balance.balanceDisponible)}
        </p>
        <p class="text-xs text-neutral-300">
          Total: ${customCashFormat(balance.balanceTotal)}
        </p>
        <div class="flex flex-col gap-2">
          <p class="text-green-200 flex gap-2 items-center">
            <IconArrowUp /> Ingresos: $
            {customCashFormat(balance.incomeDisponible)}
          </p>
          <p class="text-red-200 flex gap-2 items-center">
            <IconArrowDown /> Gastos: $
            {customCashFormat(balance.expenseDisponible)}
          </p>
        </div>
      </div>
    </div>
  ) : (
    <p>No se puede cargar el balance...</p>
  )
}
