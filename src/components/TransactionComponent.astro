---
import {
  IconTrendingUp,
  IconTrendingDown,
  IconTargetArrow,
  IconShoppingBag,
  IconBus,
  IconHome,
} from "@tabler/icons-react";

interface Props {
  id: string;
  type: "INCOME" | "EXPENSE";
  amount: number;
  category: string;
  description: string;
  date: Date;
  goalId?: string;
  goal: { name: string };
}

const { id, type, amount, category, description, goalId, goal } = Astro.props;

// --- Helpers Visuales ---
const isExpense = type === "EXPENSE";

// Formato Moneda Colombiana
const formattedAmount = Number(amount).toLocaleString("es-CO", {
  style: "currency",
  currency: "COP",
  maximumFractionDigits: 0, // En COP raramente usamos centavos en apps visuales
});

// Selección de Icono Simple basada en string (puedes expandir esto)
const getIcon = (cat: string) => {
  const c = cat.toLowerCase();
  if (c.includes("transporte")) return IconBus;
  if (c.includes("hogar") || c.includes("casa")) return IconHome;
  return IconShoppingBag; // Default
};

const CategoryIcon = getIcon(category);
---

<a
  href={`/app/transaction/${id}`}
  class="group relative flex items-center justify-between bg-white p-4 rounded-2xl shadow-sm border border-neutral-100 transition-all hover:shadow-md active:scale-[0.99] no-underline!"
>
  {/* IZQUIERDA: Icono + Textos */}
  <div class="flex items-center gap-4 overflow-hidden">
    {/* Icono Circular */}
    <div
      class={`
      flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center
      ${isExpense ? "bg-neutral-100 text-neutral-600" : "bg-emerald-100 text-emerald-600"}
    `}
    >
      {isExpense ? <CategoryIcon size={22} /> : <IconTrendingUp size={22} />}
    </div>

    {/* Info Principal */}
    <div class="flex flex-col min-w-0">
      <div class="flex items-center gap-2">
        <span
          class="font-semibold text-neutral-900 truncate text-sm sm:text-base"
        >
          {category || "General"}
        </span>

        {/* Badge de Meta (Si existe) - Sutil y elegante */}
        {
          goalId && (
            <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-bold bg-indigo-50 text-indigo-600 border border-indigo-100">
              <IconTargetArrow size={10} />
              {goal.name}
            </span>
          )
        }
      </div>

      <span class="text-xs text-neutral-500 truncate mt-0.5">
        {description || (isExpense ? "Gasto realizado" : "Ingreso recibido")}
      </span>
    </div>
  </div>

  {/* DERECHA: Monto */}
  <div class="flex flex-col items-end flex-shrink-0 pl-2">
    <span
      class={`
      font-bold text-sm sm:text-base tabular-nums
      ${!isExpense ? "text-emerald-600" : "text-neutral-900"}
    `}
    >
      {isExpense ? "- " : "+ "}{formattedAmount}
    </span>

    {/* Hora (Opcional, ya que la fecha está en el header) */}
    <span class="text-[10px] text-neutral-400">
      {
        new Date(Astro.props.date).toLocaleTimeString("es-CO", {
          hour: "2-digit",
          minute: "2-digit",
        })
      }
    </span>
  </div>
</a>
