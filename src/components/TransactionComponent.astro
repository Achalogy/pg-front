---
import { IconCash, IconCoins, IconExternalLink } from "@tabler/icons-react";

interface Props {
  id: string;
  type: "INCOME" | "EXPENSE";
  amount: number;
  category: string;
  description: string;
  date: Date;
  createdAt: Date;
  goalId?: string;
  goal: {
    name: string;
  };
}

const transaction: {
  id: string;
  type: "INCOME" | "EXPENSE";
  amount: number;
  category: string;
  description: string;
  date: Date;
  createdAt: Date;
  goalId?: string;
  goal: {
    name: string;
  };
} = Astro.props;
---

<div class="flex flex-col rounded-xl bg-white p-3 px-4 gap-1">
  {
    transaction.goalId && (
      <p class="flex gap-2 text-xs items-center px-2 p-1 bg-neutral-100 mr-auto rounded min-w-1/3">
        Transacción de la meta{" "}
        <a
          class="flex gap-1 items-center"
          href={`/app/goal/${transaction.goalId}`}
        >
          {transaction.goal.name}
          <IconExternalLink className="h-4 w-4" />
        </a>
      </p>
    )
  }
  <div class="flex justify-between items-center">
    <div
      class="flex items-center justify-center w-1/5 max-w-10 h-10 rounded-full bg-neutral-100"
    >
      {
        transaction.type == "EXPENSE" ? (
          <IconCash className="text-red-300" />
        ) : (
          <IconCoins className="text-green-300" />
        )
      }
    </div>
    <div class="w-2/5 text-xs">
      <a
        class="text-xs text-black! no-underline!"
        href={`/app/transaction/${transaction.id}`}
      >
        <b>{transaction.type == "EXPENSE" ? "Gasto" : "Ingreso"}</b>
      </a>
      <p class="truncate text-neutral-600">
        {transaction.category ?? "Sin categoria"}
      </p>
    </div>
    <div class="w-2/5 flex justify-end">
      <b
        >${
          Number(transaction.amount).toLocaleString("es-CO", {
            minimumFractionDigits: 2,
          })
        }</b
      >
    </div>
  </div>
  <div class="flex justify-between">
    <p class="text-xs text-neutral-300 w-3/5 line-clamp-2">
      {transaction.description ?? ""}
    </p>
    <p class="text-xs text-neutral-300 text-end w-2/5">
      {new Date(transaction.date).toLocaleString("es-CO")}
    </p>
  </div>
  <!-- <a class="text-xs" href={`/app/transaction/${transaction.id}`}>Ver Detalles</a> -->
</div>
