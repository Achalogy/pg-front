---
import getGoals from "../api/goals/getGoals";
import GoalComponent from "./GoalComponent.astro";

let goals: {
  data: {
    id: string;
    name: string;
    targetAmount: number;
    deadline: Date;
    completed: boolean;
    createdAt: Date;
  }[],
  meta: {
    hasNext: boolean;
    totalCount: number;
    count: number;
    next: number;
  };
} | null = null;

try {
  goals = await getGoals(Astro);
} catch (err) {}
---

<>
  {
    goals &&
      (goals?.data ?? [])?.map((x) => {
        return <GoalComponent {...x} />;
      })
  }
</>
