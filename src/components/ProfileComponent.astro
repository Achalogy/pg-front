---
import getUser from "../utils/getUser";
import { IconSettings } from "@tabler/icons-react";

let user: {
  name: string;
  email: string;
} | null = null;

try {
  user = await getUser(Astro);
} catch (err) {}
---

<div class="flex justify-between items-center">
  <div class="flex gap-4 items-center">
    <div class="h-12 w-12 rounded-full bg-red-200">
      <img src="" alt="" />
    </div>

    <div class="flex flex-col gap-1">
      {user && <b>{user.name}</b>}
      {user && <p>{user.email}</p>}
    </div>
  </div>

  <a href="/log-in">
    <div
      class="flex items-center justify-center bg-black h-8 w-8 aspect-square rounded-full"
    >
      <IconSettings className="text-white w-6 h-6" />
    </div>
  </a>
</div>
