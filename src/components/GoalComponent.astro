---
import { IconPigMoney } from "@tabler/icons-react";
import SimpleProgressBar from "./SimpleProgressBar.astro";
import customCashFormat from "../utils/customCashFormat";

interface Props {
  id: string;
  name: string;
  targetAmount: number;
  deadline: Date;
  completed: boolean;
  createdAt: Date;
  currentBalance: number;
}

const goal: Props = Astro.props;
---

<div class="flex flex-col rounded-xl bg-white p-3 px-4 gap-1">
  <div class="flex justify-between items-center">
    <div
      class="flex items-center justify-center w-1/5 max-w-10 h-10 rounded-full bg-indigo-200 text-white"
    >
      <IconPigMoney />
    </div>
    <div class="w-2/5 text-xs">
      <a
        class="text-xs text-black! no-underline!"
        href={`/app/goal/${goal.id}`}
      >
        <b>{goal.name}</b>
      </a>
    </div>
    <div class="w-2/5 flex flex-col gap-1 justify-end">
      <p class="text-xs text-end text-neutral-500">
        ${customCashFormat(goal.currentBalance)} /
        <b>${customCashFormat(goal.targetAmount)}</b>
      </p>
      <SimpleProgressBar
        done={goal.completed}
        max={goal.targetAmount}
        curr={goal.currentBalance}
      />
    </div>
  </div>
  <div class="flex justify-between">
    <p class="text-xs text-neutral-300 w-3/5 line-clamp-2">
      <!-- {transaction.description ?? ""} -->
    </p>
    <p class="text-xs text-neutral-300 text-end w-2/5">
      {new Date(goal.deadline).toLocaleString("es-CO")}
    </p>
  </div>
</div>
