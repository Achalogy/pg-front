---
import getTransactions from "../api/transactions/getTransactions";
import TransactionComponent from "./TransactionComponent.astro";

let transactions: {
  data: {
    id: string;
    type: "INCOME" | "EXPENSE";
    amount: number;
    category: string;
    description: string;
    date: Date;
    createdAt: Date;
    goalId?: string;
    goal: {
      name: string;
    };
  }[];
  meta: {
    hasNext: boolean;
    totalCount: number;
    count: number;
    next: number;
  };
} | null = null;

try {
  transactions = await getTransactions(Astro);
} catch (err) {}
---

<>
  {
    transactions &&
      (transactions?.data ?? [])?.map((x) => {
        return <TransactionComponent {...x} />;
      })
  }
</>
