---

---

<div class="w-full max-w-120 mx-auto p-4 bg-white rounded-lg space-y-4">
  <h2 class="text-lg font-bold">Simulador de interés compuesto</h2>

  <label>
    Monto inicial (COP)
    <input
      type="number"
      id="compuesto-principal"
      class="bg-white p-2 rounded-md w-full"
    />
  </label>

  <label>
    Tasa anual (%)
    <input
      type="number"
      id="compuesto-tasa"
      class="bg-white p-2 rounded-md w-full"
    />
  </label>

  <label>
    Número de años
    <input
      type="number"
      id="compuesto-anos"
      class="bg-white p-2 rounded-md w-full"
    />
  </label>

  <button id="btn-compuesto" class="bg-indigo-500 text-white p-2 rounded-md"
    >Calcular</button
  >

  <div id="compuesto-result" class="space-y-1">
    <p>Total al final de un año: COP $0</p>
    <p>Total al final de un mes: COP $0</p>
    <p>Total al final de una semana: COP $0</p>
  </div>
</div>

<div class="max-w-2xl mx-auto p-4 bg-gray-100 rounded-lg space-y-4">
  <h2 class="text-xl font-bold">Guía del simulador de interés compuesto</h2>

  <div>
    <strong>Monto inicial (COP):</strong>
    <p>
      Es la cantidad de dinero que quieres invertir o ahorrar al inicio del
      periodo. No incluye intereses aún.
    </p>
  </div>

  <div>
    <strong>Tasa anual (%):</strong>
    <p>
      Porcentaje de interés que se aplicará sobre tu capital cada año. Por
      ejemplo, 10% = 0.10.
    </p>
  </div>

  <div>
    <strong>Número de años:</strong>
    <p>
      Es el tiempo que mantendrás el dinero invertido o ahorrado. Cada año se
      aplica la tasa de interés sobre el capital acumulado.
    </p>
  </div>

  <div>
    <strong>Total al final de un año:</strong>
    <p>
      Monto acumulado después del primer año, incluyendo el capital inicial más
      los intereses generados durante ese año.
    </p>
  </div>

  <div>
    <strong>Total al final de un mes:</strong>
    <p>
      Monto promedio aproximado que tendrás al final de cada mes del primer año.
    </p>
  </div>

  <div>
    <strong>Total al final de una semana:</strong>
    <p>
      Monto promedio aproximado que tendrás al final de cada semana del primer
      año.
    </p>
  </div>

  <div>
    <strong>Total acumulado al final de todos los años:</strong>
    <p>
      Es el monto total que tendrás al finalizar todos los años indicados,
      aplicando interés compuesto anual.
    </p>
  </div>

  <div>
    <strong>Nota:</strong>
    <p>
      Los totales mensual y semanal son aproximados y no reflejan capitalización
      real por mes o semana, solo promedios para visualizar evolución del
      ahorro.
    </p>
  </div>
</div>

<script>
  import customCashFormat from "../utils/customCashFormat";

  const btnCompuesto = document.getElementById("btn-compuesto");
  btnCompuesto.addEventListener("click", () => {
    const principal =
      Number(document.getElementById("compuesto-principal").value) || 0;
    const tasaAnual =
      Number(document.getElementById("compuesto-tasa").value) / 100 || 0;
    const anos = Number(document.getElementById("compuesto-anos").value) || 0;

    // Interés compuesto para un año
    const totalUnAno = principal * (1 + tasaAnual);
    const totalUnMes = totalUnAno / 12;
    const totalUnaSemana = totalUnAno / 52;

    // Interés compuesto para todos los años
    const totalTodosAnios = principal * Math.pow(1 + tasaAnual, anos);

    // Total mensual y semanal con capitalización mensual y semanal
    const totalMensual = principal * Math.pow(1 + tasaAnual / 12, anos * 12);
    const totalSemanal = principal * Math.pow(1 + tasaAnual / 52, anos * 52);

    const div = document.getElementById("compuesto-result");
    div.innerHTML = `
      <p>Total al final de un año: COP ${customCashFormat(totalUnAno)}</p>
      <p>Total al final de un mes: COP ${customCashFormat(totalUnMes)}</p>
      <p>Total al final de una semana: COP ${customCashFormat(totalUnaSemana)}</p>
      <p>Total acumulado al final de ${anos} años: COP ${customCashFormat(totalTodosAnios)}</p>`;
  });
</script>
